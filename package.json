{
  "name": "oomol-fusion-sdk",
  "version": "2.0.0",
  "description": "Extensible TypeScript SDK for Fusion API task and action endpoints",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./api-error": {
      "types": "./dist/api-error.d.ts",
      "import": "./dist/api-error.js"
    },
    "./openapi-types": {
      "types": "./dist/generated/openapi-types.d.ts",
      "import": "./dist/generated/openapi-types.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "README.zh-CN.md",
    "README.ai.md",
    "CAPABILITIES.md",
    "AGENT_GUIDE.md"
  ],
  "scripts": {
    "generate:services": "node ./scripts/generate-services-from-openapi.mjs",
    "generate:types": "node ./scripts/generate-openapi-types.mjs",
    "build": "tsc -p tsconfig.json",
    "type-check": "tsc --noEmit",
    "verify:types": "tsc -p tsconfig.verify.json --noEmit",
    "generate": "npm run generate:services && npm run generate:types && npm run build",
    "check": "npm run generate && npm run verify:types"
  },
  "keywords": [
    "fusion",
    "sdk",
    "typescript",
    "api",
    "ai",
    "tasks"
  ],
  "author": "OOMOL",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.3.0"
  }
}
